# Valores por defecto de la app. Se usan en el primer inicio o al restablecer
# la configuración desde Ajustes. En producción la configuración vive en el
# directorio de datos de la app.
N8N_BASE_URL=http://localhost:5678
N8N_TIMEOUT_SECS=15

# Opcional: Basic Auth para instancias antiguas de n8n.
# n8n 1.x+ usa cuentas de usuario y los webhooks no requieren credenciales.
N8N_USER=
N8N_PASSWORD=
