{
  "name": "n8n-studio",
  "private": true,
  "version": "1.0.0",
  "description": "A polished Tauri 2 + React desktop starter for local n8n workflows",
  "type": "module",
  "author": "Marcos Bentivegna",
  "license": "MIT",
  "homepage": "https://github.com/MarcosBentivegna/tauri-n8n-app-template#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcosBentivegna/tauri-n8n-app-template.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dev:n8n": "docker compose up -d",
    "dev:full": "npm run dev:n8n && npm run dev:app",
    "n8n:import": "bash scripts/import-workflows.sh",
    "stop:n8n": "docker compose down",
    "build": "npm run typecheck && vite build",
    "build:app": "tauri build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "framer-motion": "^14.9.1",
    "lucide-react": "^1.69.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
